package mystore;

import java.util.Scanner;

/**
 *
 * @author sweyer2027
 */
public class MyStore {

    public static void main(String[] args) {

        Scanner scan = new Scanner(System.in);

        final double MAX_BUDGET = 250.00;

        double total = 0.00;
        int count = 0;

        while (true) {

            System.out.println("\nWelcome to MyStore!");
            System.out.println("Items available:");
            System.out.println("T Shirt - 29.99");
            System.out.println("Shoes - 125.99");
            System.out.println("Jeans - 60.99");
            System.out.println("Jacket - 250.00");
            System.out.println("Hat - 25.99");
            System.out.println("Shorts - 75.99");
            System.out.println("Blouse - 88.99");
            System.out.println("Enter 'done' to finish.");

            System.out.print("\nEnter an item: ");
            String name = scan.nextLine();

            if (name.equalsIgnoreCase("done")) {
                break;
            }

            Item item = new Item();

            if (name.equalsIgnoreCase("T Shirt")) {
                item.setStrName("T Shirt");
                item.setDblPrice(29.99);
            }
            else if (name.equalsIgnoreCase("Shoes")) {
                item.setStrName("Shoes");
                item.setDblPrice(125.99);
            }
            else if (name.equalsIgnoreCase("Jeans")) {
                item.setStrName("Jeans");
                item.setDblPrice(60.99);
            }
            else if (name.equalsIgnoreCase("Jacket")) {
                item.setStrName("Jacket");
                item.setDblPrice(250.00);
            }
            else if (name.equalsIgnoreCase("Hat")) {
                item.setStrName("Hat");
                item.setDblPrice(25.99);
            }
            else if (name.equalsIgnoreCase("Shorts")) {
                item.setStrName("Shorts");
                item.setDblPrice(75.99);
            }
            else if (name.equalsIgnoreCase("Blouse")) {
                item.setStrName("Blouse");
                item.setDblPrice(88.99);
            }
            else {
                System.out.println("Invalid item. Please try again.");
                continue;
            }

            if (total + item.getDblPrice() > MAX_BUDGET) {
                System.out.println("Warning! This item would put you over budget.");
                System.out.println("Your budget is $" + MAX_BUDGET);
            }
            else {
                total = total + item.getDblPrice();
                count++;

                System.out.println(item);
                System.out.println("Items purchased: " + count);
                System.out.printf("Total spent: $%.2f%n", total);
            }
        }

        System.out.println("\nThank you for shopping at MyStore!");
        System.out.println("Total items purchased: " + count);
        System.out.printf("Final total: $%.2f%n", total);
    }
}

class Item {

    private String strName;
    private double dblPrice;

    public String getStrName() {
        return strName;
    }

    public void setStrName(String strName) {
        this.strName = strName;
    }

    public double getDblPrice() {
        return dblPrice;
    }

    public void setDblPrice(double dblPrice) {
        this.dblPrice = dblPrice;
    }
}
